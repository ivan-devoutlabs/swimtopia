{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "1200px",
			"wideSize": "1600px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": true,
			"customDuotone": false,
			"palette": [
				{ "slug": "white",       "color": "#fff", "name": "White" },
				{ "slug": "navy",       "color": "#0E295E", "name": "Navy" },
				{ "slug": "blue",       "color": "#025FFF", "name": "Blue" },
				{ "slug": "light-blue",       "color": "#99DAFB", "name": "Light Blue" },
				{ "slug": "border-light-blue",       "color": "#51BDF3", "name": "Border Light Blue" },
				{ "slug": "neutral",       "color": "#807B73", "name": "Neutral" },
				{ "slug": "light-gray",       "color": "#E1E1E1", "name": "Light Gray" },
				{ "slug": "light",       "color": "#FAFCFC", "name": "Light" },
				{ "slug": "dark",       "color": "#1A1A1A", "name": "Dark" },
				{ "slug": "yellow",       "color": "#FFDF28", "name": "Yellow" },
				{ "slug": "accent-1",       "color": "#F7ECDC", "name": "Accent 1" },
				{ "slug": "accent-2",       "color": "#B8D6E5", "name": "Accent 2" },
				{ "slug": "accent-3",       "color": "#DB6A58", "name": "Accent 3" },
				{ "slug": "accent-4",       "color": "#FF5532", "name": "Accent 4" }
			]
		},
		"typography": {
			"fluid": {
				"minViewportWidth": "376px",
				"maxViewportWidth": "1440px"
			},
			"customFontSize": true,
			"dropCap": false,
			"fontFamilies": [
				{
					"slug": "primary",
					"name": "Primary",
					"fontFamily": "\"SeasonSans\", system-ui, -apple-system, sans-serif",
					"fontFace": [
					{
						"fontFamily": "SeasonSans",
						"fontWeight": "400",
						"fontStyle": "normal",
						"fontDisplay": "swap",
						"src": [ "file:./assets/fonts/SeasonSans-TRIAL-Regular.otf" ]
					},
					{
						"fontFamily": "SeasonSans",
						"fontWeight": "500",
						"fontStyle": "normal",
						"fontDisplay": "swap",
						"src": [ "file:./assets/fonts/SeasonSans-TRIAL-Medium.otf" ]
					},
					{
						"fontFamily": "SeasonSans",
						"fontWeight": "600",
						"fontStyle": "normal",
						"fontDisplay": "swap",
						"src": [ "file:./assets/fonts/SeasonSans-TRIAL-SemiBold.otf" ]
					},
					{
						"fontFamily": "SeasonSans",
						"fontWeight": "700",
						"fontStyle": "normal",
						"fontDisplay": "swap",
						"src": [ "file:./assets/fonts/SeasonSans-TRIAL-Bold.otf" ]
					}
					]
				}
			],
			"fontSizes": [
				{ "slug": "text-xs",    "name": "Text Xs",    "size": "1rem",
				  "fluid": { "min": "0.875rem", "max": "1rem" } },
				{ "slug": "text-s",    "name": "Text S",    "size": "1.125rem",
				  "fluid": { "min": "1rem", "max": "1.125rem" } },
				{ "slug": "text-m",    "name": "Text M",    "size": "1.25rem",
				  "fluid": { "min": "1.125rem", "max": "1.25rem" } },
				{ "slug": "text-L",    "name": "Text L",    "size": "1.5rem",
				  "fluid": { "min": "1.25rem", "max": "1.5rem" } },
				{ "slug": "text-xl",    "name": "Text Xl",    "size": "2rem",
				  "fluid": { "min": "1.375rem", "max": "2rem" } },
				{ "slug": "text-xxl",    "name": "Text XXl",    "size": "2.5rem",
				  "fluid": false },
				{ "slug": "heading-1",    "name": "Heading 1",    "size": "4.5rem",
				  "fluid": { "min": "2.5rem", "max": "4.5rem" } },
				{ "slug": "heading-2",    "name": "Heading 2",    "size": "4rem",
				  "fluid": { "min": "2rem", "max": "4rem" } },
				{ "slug": "heading-3",    "name": "Heading 3",    "size": "3.25rem",
				  "fluid": { "min": "1.75rem", "max": "3.25rem" } },
				{ "slug": "heading-4",    "name": "Heading 4",    "size": "3rem",
				  "fluid": { "min": "1.625rem", "max": "3rem" } },
				{ "slug": "heading-5",    "name": "Heading 5",    "size": "2.375rem",
				  "fluid": { "min": "1.5rem", "max": "2.375rem" } },
				{ "slug": "heading-6",    "name": "Heading 6",    "size": "2rem",
				  "fluid": { "min": "1.375rem", "max": "2rem" } },
				{ "slug": "title-s",    "name": "Title S",    "size": "3.75rem",
				  "fluid": { "min": "1.75rem", "max": "3.75rem" } },
				{ "slug": "title-m",    "name": "Title M",    "size": "4.375rem",
				  "fluid": { "min": "3.125rem", "max": "4.375rem" } },
				{ "slug": "title-l",    "name": "Title L",    "size": "5rem",
				  "fluid": { "min": "2.5rem", "max": "5rem" } },
				{ "slug": "title-xl",    "name": "Title XL",    "size": "6.875rem",
				  "fluid": { "min": "3.125rem", "max": "6.875rem" } },
				{ "slug": "title-xxl",    "name": "Title XXL",    "size": "8.75rem",
				  "fluid": { "min": "3.125rem", "max": "8.75rem" } }
			]
		},
		"spacing": {
			"padding": true,
			"margin": true,
			"blockGap": true,
			"customSpacingSize": true,
			"units": [ "px", "rem", "%", "vw", "vh" ],
			"spacingSizes": [
				{ "slug": "2-xs", "name": "2XS", "size": "0.5rem" },
				{ "slug": "xs",   "name": "XS",  "size": "1rem" },
				{ "slug": "sm",   "name": "SM",  "size": "1.5rem" },
				{ "slug": "md",   "name": "MD",  "size": "2.5rem" },
				{ "slug": "lg",   "name": "LG",  "size": "4rem" },
				{ "slug": "xl",   "name": "XL",  "size": "6rem" },
				{ "slug": "2-xl", "name": "2XL", "size": "8rem" }
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "soft-shadow", "name": "Soft",
				  "shadow": "0 4px 24px rgba(20, 21, 25, 0.12)" },
				{ "slug": "hard-shadow", "name": "Hard",
				  "shadow": "0 2px 8px rgba(20, 21, 25, 0.25)" }
			]
		},
		"blocks": {
			"core/group": {
				"spacing": {
					"padding": true,
					"margin": true
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--neutral-900)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--primary)",
			"fontSize": "var(--wp--preset--font-size--text-regular)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--sm)",
			"padding": {
				"left": "var(--wp--preset--spacing--sm)",
				"right": "var(--wp--preset--spacing--sm)"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--secondary)" }
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--primary)",
					"fontWeight": "700",
					"lineHeight": "1.2"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--heading-1)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--heading-2)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--heading-3)" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--heading-4)" } },
			"h5": { "typography": { "fontSize": "var(--wp--preset--font-size--heading-5)" } },
			"h6": { "typography": { "fontSize": "var(--wp--preset--font-size--heading-6)" } }
		}
	}
}
